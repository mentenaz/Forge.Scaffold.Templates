{
  "id": "spfx-webpart",
  "version": "1.20.0",
  "title": "SPFx solution with a web part (React)",
  "description": "A complete SharePoint Framework solution with a React web part. To add a web part to a solution you already have, use \"Web part (React)\".",
  "tags": [
    "spfx",
    "webpart",
    "react"
  ],
  "prompts": [
    {
      "key": "solutionName",
      "type": "text",
      "label": "Solution name",
      "rule": "solution-name"
    },
    {
      "key": "solutionDescription",
      "type": "text",
      "label": "Solution description",
      "default": "My SPFx solution"
    },
    {
      "key": "webparts",
      "type": "list",
      "label": "Web part names",
      "rule": "webpart-names"
    },
    {
      "key": "fastServe",
      "type": "bool",
      "default": false,
      "label": "Add SPFx Fast Serve (a community add-on for a faster dev server)"
    },
    {
      "key": "install",
      "type": "bool",
      "label": "Run install afterwards",
      "default": false
    }
  ],
  "folderFrom": "solutionName",
  "nestedMarker": ".yo-rc.json",
  "guids": [
    "solutionId",
    "featureId"
  ],
  "include": [
    {
      "folder": "solution"
    },
    {
      "folder": "fastserve",
      "to": "fast-serve",
      "when": {
        "key": "fastServe",
        "equals": true
      }
    }
  ],
  "repeat": [
    {
      "over": "webparts",
      "as": "webpart",
      "folder": "webpart",
      "guids": [
        "webpartId"
      ]
    }
  ],
  "merge": [
    {
      "file": "package.json",
      "strategy": "json-set",
      "path": "devDependencies.spfx-fast-serve-helpers",
      "value": "~1.20.0",
      "when": {
        "key": "fastServe",
        "equals": true
      }
    },
    {
      "file": "package.json",
      "strategy": "json-set",
      "path": "scripts.serve",
      "value": "gulp clean && gulp build && fast-serve",
      "when": {
        "key": "fastServe",
        "equals": true
      }
    },
    {
      "file": "config/config.json",
      "strategy": "json-set",
      "path": "bundles.{__webpartKebab__}-web-part",
      "per": "webparts",
      "value": {
        "components": [
          {
            "entrypoint": "./lib/webparts/{__webpartCamel__}/{__webpartPascal__}WebPart.js",
            "manifest": "./src/webparts/{__webpartCamel__}/{__webpartPascal__}WebPart.manifest.json"
          }
        ]
      }
    },
    {
      "file": "config/config.json",
      "strategy": "json-set",
      "path": "localizedResources.{__webpartPascal__}WebPartStrings",
      "per": "webparts",
      "value": "lib/webparts/{__webpartCamel__}/loc/{locale}.js"
    }
  ],
  "post": [
    {
      "action": "install",
      "when": {
        "key": "install",
        "equals": true
      }
    }
  ],
  "packageManagers": {
    "default": "npm",
    "tested": [
      "npm"
    ]
  },
  "parts": [
    {
      "target": "gulpfile.js",
      "source": "fragments/gulpfile.head.js"
    },
    {
      "target": "gulpfile.js",
      "source": "fragments/gulpfile.fastserve.js",
      "when": {
        "key": "fastServe",
        "equals": true
      }
    },
    {
      "target": "gulpfile.js",
      "source": "fragments/gulpfile.tail.js"
    }
  ],
  "requires": {
    "node": ">=18.17.1 <19.0.0"
  }
}
