{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/package-solution.schema.json",
  "solution": {
    "name": "{__solutionName__}-client-side-solution",
    "id": "{__solutionId__}",
    "version": "1.0.0.0",
    "includeClientSideAssets": true,
    "skipFeatureDeployment": true,
    "isDomainIsolated": false,
    "developer": {
      "name": "",
      "websiteUrl": "",
      "privacyUrl": "",
      "termsOfUseUrl": "",
      "mpnId": "Undefined-1.22.2"
    },
    "metadata": {
      "shortDescription": {
        "default": "{__solutionDescription__}"
      },
      "longDescription": {
        "default": "{__solutionDescription__}"
      },
      "screenshotPaths": [],
      "videoUrl": "",
      "categories": []
    },
    "features": [
      {
        "title": "{__solutionName__} Feature",
        "description": "The feature that activates elements of the {__solutionName__} solution.",
        "id": "{__featureId__}",
        "version": "1.0.0.0"
      }
    ]
  },
  "paths": {
    "zippedPackage": "solution/{__solutionName__}.sppkg"
  }
}
